# Dockerfile.czi — Extended image for CZI preprocessing
# Adds libCZI, aicsimageio, and Dask support on top of the Ultralytics base.
#
# Build: docker build -f Dockerfile.czi -t ttl.sh/pollen-czi-RAND:24h .
# Push:  docker push ttl.sh/pollen-czi-RAND:24h

FROM ultralytics/ultralytics:latest

WORKDIR /app

# System packages needed by libCZI / Pillow / OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libzstd-dev \
    libjpeg-dev \
    libpng-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Python packages
RUN pip install --no-cache-dir \
    boto3 \
    pandas \
    "aicsimageio[czi]" \
    aicspylibczi \
    pylibCZIrw \
    gspread \
    "google-auth>=2.0"

# Copy application code
COPY src/ ./

# Fix permissions for the non-root Kubernetes user (UID 1000)
RUN chown -R 1000:1000 /app && \
    mkdir -p /ultralytics/runs && \
    chown -R 1000:1000 /ultralytics

USER 1000

# Default: show usage — override with actual args in K8s job spec
CMD ["python", "czi_ingest.py", "--help"]
